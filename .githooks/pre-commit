#!/bin/sh
# Pre-commit PII/secret guard.
#
# Uruni is developed against a real community's fund — real neighbours' names,
# real amounts. That data must never reach a public AGPL repo. This hook blocks
# a commit whose staged ADDITIONS match any rule in .pii-patterns (gitignored,
# one POSIX extended-regex per line, case-insensitive; blank lines and
# #-comments ignored). The denylist is local-only because the real terms are
# themselves the PII — run `make hooks-install` to set it up.
#
# Reports only the offending filenames, never the matched content, so a blocked
# commit doesn't echo the PII back into a terminal or an agent's context.
#
# Bypass is deliberately unsupported as policy: do NOT use `git commit --no-verify`.
set -eu

pf=".pii-patterns"
if [ ! -f "$pf" ]; then
  echo "pii-guard: no $pf — run 'make hooks-install' to enable; skipping." >&2
  exit 0
fi

# Join the active rules into one alternation. Nothing to do if all are comments.
regex=$(grep -vE '^[[:space:]]*($|#)' "$pf" | paste -sd'|' -)
[ -z "$regex" ] && exit 0

# Attribution and licensing files reproduce names/emails *by design* to satisfy
# notice obligations, so scanning them for PII is a category error and would
# block every regen. Exempt them.
#
# NOTICE matters immediately: `make hooks-install` seeds .pii-patterns with your
# own git identity, and AGPL-3.0's "how to apply" appendix wants exactly that
# name as the copyright holder — so without this rule the guard blocks the
# project from stating its own copyright. (THIRD-PARTY-NOTICES doesn't exist
# yet; the rule is here so it doesn't have to be rediscovered when it does.)
is_attribution() {
  case "$1" in
    LICENSE|NOTICE|COPYRIGHT|THIRD-PARTY-NOTICES|web/licenses/*) return 0 ;;
    *) return 1 ;;
  esac
}

# NOTE: filenames with spaces aren't handled (none in this repo); revisit if that changes.
bad=""
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  if is_attribution "$f"; then continue; fi
  if git diff --cached --no-color -U0 -- "$f" \
      | grep -E '^\+' | grep -vE '^\+\+\+' \
      | grep -iqE "$regex"; then
    bad="$bad $f"
  fi
done

if [ -n "$bad" ]; then
  echo "✗ pii-guard: staged additions match a .pii-patterns rule — commit blocked:" >&2
  for f in $bad; do echo "    $f" >&2; done
  echo "  Scrub to neutral fixtures + toy amounts, then re-stage. Do NOT use --no-verify." >&2
  exit 1
fi
exit 0
