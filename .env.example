# Pinned Uruni image tag. Bump to the new release BEFORE tagging it
# (see docs/ROADMAP.md — release hygiene). The tagged tree must recommend itself.
URUNI_TAG=v0.4.0

# Public base URL + domain of this instance (used for the shareable report link,
# and its scheme decides whether the session cookie is Secure). These are the
# self-host values; `make setup` rewrites URUNI_BASE_URL to a loopback http
# origin in the .env it generates, so local dev actually keeps the cookie.
#
# URUNI_BASE_URL is required, and the server refuses to start on the placeholder
# below (ADR-019) — an instance that hands out a report link nobody else can
# open is the one misconfiguration that looks like it worked.
URUNI_BASE_URL=https://uruni.example.com
URUNI_DOMAIN=uruni.example.com

# Listen port. The compose stack keeps the default and lets Caddy front it;
# `make run` / `make restart` read this too, so the readiness poll follows.
# PORT=8080

# SQLite file path. SQLite is the only store (ADR-004) — there is no
# DATABASE_URL. In the compose stack this is overridden to /data/uruni.db,
# on the named volume.
# URUNI_DB=./uruni.db

# Optional: SMTP for emailed periodic backups (see PRD 7.10).
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# Logging (ADR-022). Level: debug | info | warn | error. Format: text | json —
# text is easier to read in `docker compose logs`, json if you ship them
# somewhere that parses them.
# URUNI_LOG_LEVEL=info
# URUNI_LOG_FORMAT=text
