# Pinned Uruni image tag. Bump to the new release BEFORE tagging it
# (see docs/ROADMAP.md - release hygiene). The tagged tree must recommend itself.
URUNI_TAG=v0.7.0-alpha.1

# Public base URL of this instance: the one origin everything derives from -
# the shareable report link, whether the session cookie is Secure (its scheme),
# the site address Caddy serves and fetches TLS for, and the host the vite dev
# server accepts. This is the self-host value; `make setup` rewrites it to a
# loopback http origin in the .env it generates, so local dev keeps the cookie.
#
# URUNI_BASE_URL is required, and the server refuses to start on the placeholder
# below (ADR-019) - an instance that hands out a report link nobody else can
# open is the one misconfiguration that looks like it worked.
URUNI_BASE_URL=https://uruni.example.com

# Listen port. The compose stack keeps the default and lets Caddy front it;
# `make run` / `make restart` read this too, so the readiness poll follows.
# PORT=8080

# SQLite file path. SQLite is the only store (ADR-004) - there is no
# DATABASE_URL. In the compose stack this is overridden to /data/uruni.db,
# on the named volume.
# URUNI_DB=./uruni.db

# Local volume for uploaded receipt photos (ADR-011). In the compose stack
# this is overridden to /uploads, on its own named volume - `make setup`
# creates the relative default below on a fresh clone, the same way it does
# not need to for URUNI_DB (SQLite creates its own file; a directory has to
# already exist).
# URUNI_UPLOADS_DIR=./uploads

# Local directory for the daily server-side backup dumps (ADR-012, ADR-013).
# In the compose stack this is overridden to /backups, on its own named
# volume - the same split as URUNI_UPLOADS_DIR above, and `make setup`
# creates the relative default below on a fresh clone for the same reason.
# URUNI_BACKUP_DIR=./backups

# Logging (ADR-022). Level: debug | info | warn | error. Format: text | json -
# text is easier to read in `docker compose logs`, json if you ship them
# somewhere that parses them.
# URUNI_LOG_LEVEL=info
# URUNI_LOG_FORMAT=text
